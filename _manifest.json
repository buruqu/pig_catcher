{
  "manifest_version": 2,
  "id": "local.pig-catcher",
  "version": "2.0.22",
  "name": "抓猪插件",
  "description": "抓猪 2.0 正式版：成就、周冲榜、自动派遣、自由乐队巡演与双人轮盘对战；含完整素材、图片结算与可恢复玩法。",
  "author": {
    "name": "buruqu",
    "url": "https://github.com/buruqu"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/buruqu/pig_catcher",
    "homepage": "https://github.com/buruqu",
    "documentation": "https://github.com/buruqu/pig_catcher/tree/main/docs",
    "issues": "https://github.com/buruqu/pig_catcher/issues"
  },
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiosqlite",
      "version_spec": ">=0.20.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "Jinja2",
      "version_spec": ">=3.1.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=11.0.0,<13.0.0"
    },
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3,<1.0.0"
    }
  ],
  "capabilities": [
    "message.get_by_time_in_chat",
    "render.html2png",
    "send.hybrid",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "piggy-bank",
      "background": "#F7DCE7"
    }
  },
  "changelog": "CHANGELOG.md"
}
